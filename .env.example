# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=jobdetector

# Email Configuration (Gmail SMTP)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
BASE_URL=https://jobdetector.blackrice.top
ADMIN_EMAIL=your_admin_email@gmail.com

# Stripe Search Console subscriptions. Set these in Vercel, never in frontend JavaScript.
# Keep false until both plans, the webhook, and Customer Portal have been tested.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional overrides; the supplied live Product/Price IDs are already in api/billing.py.
STRIPE_PRODUCT_ID=prod_VTQVFnqvuTNwG0
STRIPE_MONTHLY_PRICE_ID=price_1USTeLFC3kxu6kUOBgyDTB6A
STRIPE_ANNUAL_PRICE_ID=price_1USTfIFC3kxu6kUOZksDu146

# ── Personal Career Digest ────────────────────────────────────────────────────
# Email address to receive the daily digest (usually same as EMAIL_USERNAME)
RECIPIENT_EMAIL=your_personal_email@gmail.com

# AI Provider: "gemini" | "minimax" | "keyword" (keyword = no API needed)
AI_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# MiniMax API Key (alternative to Gemini)
MINIMAX_API_KEY=your_minimax_api_key_here
